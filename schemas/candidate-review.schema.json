{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate-only review batch (not an Android artifact)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "scopeFile", "baselineFile", "evidenceFiles", "targetIds", "candidateResultIds", "notes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "scopeFile": {"type": "string", "minLength": 1},
    "baselineFile": {"type": "string", "minLength": 1},
    "evidenceFiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "targetIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidateResultIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string", "minLength": 1}
  }
}
