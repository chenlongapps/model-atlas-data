{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate investigation evidence (not publication permission)",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets", "evidence", "systemOnly"],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"}
  },
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "benchmarkIds", "officialUrls", "status", "notes", "searches"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "benchmarkIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
          "officialUrls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/url"}},
          "status": {"enum": ["collected", "blocked"]},
          "notes": {"$ref": "#/$defs/text"},
          "searches": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["tier", "url", "outcome"],
              "properties": {"tier": {"type": "integer", "enum": [1, 2, 3, 4]}, "url": {"$ref": "#/$defs/url"}, "outcome": {"$ref": "#/$defs/text"}}
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sourceId", "url", "retrievedAt", "responseSha256", "locator", "excerpt", "notes"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "sourceId": {"$ref": "#/$defs/text"},
          "url": {"$ref": "#/$defs/url"}, "retrievedAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "string", "format": "date"}]},
          "responseSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "locator": {"$ref": "#/$defs/text"}, "excerpt": {"$ref": "#/$defs/text"}, "notes": {"$ref": "#/$defs/text"}
        }
      }
    },
    "systemOnly": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "sourceModelName", "reason"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "url": {"$ref": "#/$defs/url"},
          "sourceModelName": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}
        }
      }
    }
  }
}
